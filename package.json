{
  "name": "kindle-sync",
  "version": "1.3.0",
  "description": "Private, local book delivery for Kindle — wireless email and legacy USB on macOS.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "build": "electron-builder --mac --universal -c.mac.identity=- -c.mac.entitlements=build/entitlements.adhoc.plist -c.mac.entitlementsInherit=build/entitlements.adhoc.plist",
    "build:dir": "electron-builder --mac --universal --dir -c.mac.identity=- -c.mac.entitlements=build/entitlements.adhoc.plist -c.mac.entitlementsInherit=build/entitlements.adhoc.plist",
    "build:release": "electron-builder --mac --universal -c.forceCodeSigning=true"
  },
  "author": "KindleSync contributors",
  "license": "MIT",
  "kindleSync": {
    "googleOAuthClientId": ""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "nodemailer": "^9.0.5"
  },
  "build": {
    "appId": "com.kindlesync.app",
    "productName": "KindleSync",
    "mac": {
      "category": "public.app-category.books",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "target": ["dmg", "zip"],
      "extendInfo": {
        "NSRemovableVolumesUsageDescription": "KindleSync needs access to a connected legacy Kindle to copy books you choose."
      }
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": ["epub", "pdf", "docx"],
        "name": "Kindle document",
        "role": "Viewer"
      }
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}
