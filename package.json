{
  "name": "kindle-sync",
  "version": "1.3.0",
  "description": "Private, local book delivery for Kindle — wireless email and legacy USB on macOS.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "check": "find main.js preload.js renderer src scripts test -name '*.js' -type f -print0 | xargs -0 -n1 node --check",
    "build": "electron-builder --mac --universal --publish never -c.mac.identity=- -c.mac.entitlements=build/entitlements.adhoc.plist -c.mac.entitlementsInherit=build/entitlements.adhoc.plist",
    "build:dir": "electron-builder --mac --universal --dir -c.mac.identity=- -c.mac.entitlements=build/entitlements.adhoc.plist -c.mac.entitlementsInherit=build/entitlements.adhoc.plist",
    "build:release": "electron-builder --mac --universal -c.forceCodeSigning=true",
    "verify:package": "node scripts/verify-package.js"
  },
  "author": "KindleSync contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharat94/kindle-sync.git"
  },
  "homepage": "https://github.com/bharat94/kindle-sync#readme",
  "bugs": {
    "url": "https://github.com/bharat94/kindle-sync/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "kindleSync": {
    "googleOAuthClientId": ""
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "nodemailer": "^9.0.5"
  },
  "build": {
    "appId": "com.kindlesync.app",
    "productName": "KindleSync",
    "mac": {
      "category": "public.app-category.books",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSRemovableVolumesUsageDescription": "KindleSync needs access to a connected legacy Kindle to copy books you choose."
      }
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "epub",
          "pdf",
          "docx"
        ],
        "name": "Kindle document",
        "role": "Viewer"
      }
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}
